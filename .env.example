# Copy this file to .env and fill in your values
# cp .env.example .env

# JWT secret — use a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=change-me-to-a-random-secret

# MongoDB connection string
# Local development:
MONGODB_URI=mongodb://localhost:27017/pmserver
# MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/pmserver

# Server port (default: 3003)
PORT=3003

# Reserved for future use — Alpha Vantage API key
# ALPHAVANTAGE_KEY=your-key-here
