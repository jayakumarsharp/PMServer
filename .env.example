# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────

# JWT signing secret — generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_KEY=replace_with_64_char_random_hex

# MongoDB Atlas connection string
# Get this from: Atlas dashboard → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pmserver?retryWrites=true&w=majority

# ── Optional ──────────────────────────────────────────────────────────────────

# Port — Render sets this automatically, leave blank on Render
PORT=3003

# Comma-separated allowed frontend origins
# Set to your Vercel URL after frontend is deployed
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
