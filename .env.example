# ── PMServer Environment Variables ───────────────────────────────────────────
# LOCAL DEV: copy this to .env  →  cp .env.example .env
# PRODUCTION: set these in Railway dashboard (backend) and Vercel dashboard (frontend)

# ── Backend variables (set in Railway) ───────────────────────────────────────

# JWT signing secret — use a long random hex string in production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# MongoDB connection string
# Local:      mongodb://localhost:27017/pmserver
# Atlas:      mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/pmserver?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/pmserver

# Server port — Railway injects this automatically; keep 3003 for local
PORT=3003

# Allowed CORS origins — comma-separated, no trailing slash
# Local:      http://localhost:3000
# Production: https://pmserver.vercel.app  (replace with your actual Vercel URL)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3003

# ── Frontend variable (set in Vercel) ────────────────────────────────────────
# This is NOT secret — it gets embedded into the browser bundle.
# Local:      http://localhost:3003
# Production: https://your-pmserver.up.railway.app  (replace with your Railway URL)
NEXT_PUBLIC_API_URL=http://localhost:3003
